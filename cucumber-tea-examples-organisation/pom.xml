<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.instanto</groupId>
    <artifactId>cucumber-tea-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>cucumber-tea-examples-organisation</artifactId>
  <name>Cucumber Tea Test Organisation Examples</name>
  <description>Executable examples of organizing integration tests by capability and host.</description>

  <dependencies>
    <dependency>
      <groupId>io.instanto</groupId>
      <artifactId>cucumber-tea</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.instanto</groupId>
      <artifactId>cucumber-tea-codegen</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.teavm</groupId>
      <artifactId>teavm-classlib</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.teavm</groupId>
      <artifactId>teavm-jso</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.teavm</groupId>
      <artifactId>teavm-junit</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <executions>
          <execution>
            <id>default-testCompile</id>
            <configuration>
              <proc>full</proc>
              <annotationProcessors>
                <annotationProcessor>io.instanto.cucumber.tea.codegen.CucumberTeaProcessor</annotationProcessor>
              </annotationProcessors>
              <compilerArgs>
                <arg>-Acucumber.tea.runner=${cucumber.tea.runner}</arg>
              </compilerArgs>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>teavm</id>
      <activation>
        <activeByDefault>true</activeByDefault>
      </activation>
      <properties>
        <cucumber.tea.runner>teavm</cucumber.tea.runner>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <systemPropertyVariables>
                <teavm.junit.target>${project.build.directory}/teavm-tests</teavm.junit.target>
                <teavm.junit.js.runner>browser-chrome</teavm.junit.js.runner>
              </systemPropertyVariables>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>

    <profile>
      <id>miniflare</id>
      <properties>
        <cucumber.tea.runner>miniflare</cucumber.tea.runner>
      </properties>
      <dependencies>
        <dependency>
          <groupId>io.instanto</groupId>
          <artifactId>sarto-edge-cf-junit</artifactId>
          <version>${sarto-edge.version}</version>
          <scope>test</scope>
        </dependency>
      </dependencies>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <systemPropertyVariables>
                <teavm.junit.target>${project.build.directory}/teavm-tests</teavm.junit.target>
              </systemPropertyVariables>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
