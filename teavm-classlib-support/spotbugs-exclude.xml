<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
  <!-- TeaVM replaces java.lang.String with TString. These casts bridge the source
       API types and become identity operations in that runtime; they are not JVM
       application casts. UnicodeShimTest exercises both replace cast paths,
       toString identity and formatted in Chrome. Keep all other cast checks. -->
  <Match>
    <Class name="org.teavm.classlib.java.lang.TString"/>
    <Method name="replace" params="org.teavm.classlib.java.lang.TCharSequence,org.teavm.classlib.java.lang.TCharSequence"/>
    <Bug pattern="BC_IMPOSSIBLE_CAST"/>
  </Match>
  <Match>
    <Class name="org.teavm.classlib.java.lang.TString"/>
    <Method name="toString" params=""/>
    <Bug pattern="BC_IMPOSSIBLE_CAST"/>
  </Match>
  <Match>
    <Class name="org.teavm.classlib.java.lang.TString"/>
    <Method name="formatted" params="java.lang.Object[]"/>
    <Bug pattern="BC_IMPOSSIBLE_CAST"/>
  </Match>
</FindBugsFilter>
